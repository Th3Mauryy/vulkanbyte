# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# EmailJS — panel de EmailJS > Account / Email Services / Email Templates
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# URL pública del sitio, sin slash final. Se usa en metadatos, sitemap,
# robots.txt y JSON-LD. Al cambiar de dominio, solo se toca esta variable.
NEXT_PUBLIC_SITE_URL=https://vulkanbyte.vercel.app
